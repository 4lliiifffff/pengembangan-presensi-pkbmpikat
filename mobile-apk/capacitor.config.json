{
  "$schema": "https://capacitorjs.com/schema.json",
  "appId": "com.pkbmpikat.absen",
  "appName": "PresensiPKBMPikat-v1.0",
  "webDir": "public",
  "server": {
    "url": "https://absen.pkbmpikat.com",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0B5ED7",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0B5ED7",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Light",
      "backgroundColor": "#0B5ED7"
    }
  }
}
