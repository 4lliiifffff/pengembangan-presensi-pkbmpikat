APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Konfigurasi Sekolah & Geofencing Presensi
SEKOLAH_NAMA="PKBM Pikat"
SEKOLAH_MAPS_URL="https://maps.app.goo.gl/ahQ61nnpNQ9Z6RcWA"
SEKOLAH_LAT=-6.9308526492339295
SEKOLAH_LNG=107.60746330217363
SEKOLAH_RADIUS_METER=100
SEKOLAH_MAX_ACCURACY_METER=200

# Aturan Presensi SK & Validasi Jadwal
PRESENSI_EARLIEST_MINUTES=30
PRESENSI_TOLERANCE_MINUTES=30
PRESENSI_STRICT_SCHEDULE_GATING=true

# Kontak Admin & Fitur Cepat Pengujian
ADMIN_WA=6285156452939
APP_QUICK_LOGIN=false


APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
